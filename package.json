{
  "name": "cheeky-racoon",
  "displayName": "CheekyRacoon",
  "description": "Anonymous, offline programming telemetry for student programming assignments.",
  "version": "0.1.0",
  "publisher": "Joshua Lawson",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cheekyRacoon.openLogsFolder",
        "title": "CheekyRacoon: Open Logs Folder"
      },
      {
        "command": "cheekyRacoon.exportLogs",
        "title": "CheekyRacoon: Export Telemetry Logs"
      },
      {
        "command": "cheekyRacoon.toggle",
        "title": "CheekyRacoon: Toggle Telemetry Recording"
      },
      {
        "command": "cheekyRacoon.resetSalt",
        "title": "CheekyRacoon: Reset Anonymous Salt"
      }
    ],
    "configuration": {
      "title": "CheekyRacoon",
      "properties": {
        "cheekyRacoon.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable local anonymous telemetry logging."
        },
        "cheekyRacoon.editBurstWindowMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 30000,
          "description": "Inactivity window (ms) before flushing an aggregated edit burst event."
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "test": "node esbuild.js --test && node --test dist-test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
